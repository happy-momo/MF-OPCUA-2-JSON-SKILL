  "alias_sets": {"Reactor": ["reactor vessel"], "Pump": ["pmp"], "Motor": ["drive motor"], "Valve": ["control valve"], "OutletTemperature": ["t outlet", "outlet temp"], "Temperature": ["temp"], "Pressure": ["p disch"], "MotorSpeed": ["n motor", "rpm"], "FlowRate": ["vol flow"], "RunStatus": ["run state"]},
  "rules": {
    "score_weights": {"alias": 0.3, "regex": 0.2, "datatype": 0.1, "unit": 0.1, "parent": 0.2, "sibling": 0.1},
    "missing_evidence_score": 0.5,
    "top_k": 6,
    "hard_constraints": ["data_type", "engineering_unit", "parent_entity"],
    "data_type_aliases": {"1": "boolean", "10": "float", "11": "double"},
