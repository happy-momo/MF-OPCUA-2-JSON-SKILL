    "semantic_ambiguity_margin": 0.1
  },
  "output_contract": {"format": "opcua-standard-json", "version": "2.0", "required_artifacts": ["standard_model.json", "mapping_results.json", "review_queue.json", "unmapped_nodes.json", "result_package.json"], "optional_artifacts": ["canonical_model.json"], "required_hierarchy_levels": ["Site", "Area", "Line", "Equipment", "Variable"], "candidate_code_policy": "Bundle codes only.", "provenance_policy": "Preserve source NodeId and evidence; label synthetic fallbacks."},
  "review_policy": {
    "auto_accept_threshold": 0.9,
    "review_threshold": 0.65,
    "reject_threshold": 0.4,
    "boundary_precedence": "auto_accepted >= auto threshold; else needs_review >= review threshold; else rejected < reject threshold; otherwise unmapped.",
    "mandatory_review_triggers": ["semantic ambiguity", "candidate tie", "unit or data-type conflict", "unresolved parent", "synthetic hierarchy fallback", "bundle_gap", "semantic fallback"],
    "strict_mode": "Only auto_accepted records enter standard_model.",
    "agent_review": {"required": true, "agent_verdicts": ["confirmed", "incorrect", "ambiguous", "insufficient_evidence", "bundle_gap"]}
  }
}