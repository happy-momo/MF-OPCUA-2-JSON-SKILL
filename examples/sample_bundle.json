  "structure_schema": {
    "schema_id": "urn:example:sample-bundle:hierarchy:2",
    "levels": ["Site", "Area", "Line", "Equipment", "Variable"],
    "level_definitions": {"Site": "Plant/site boundary.", "Area": "Site subdivision.", "Line": "Project-specific production grouping, not a universal IEC class.", "Equipment": "Physical or logical asset.", "Variable": "Asset-associated measurement, state, command, or setpoint."},
    "allowed_parent_levels": {"Site": [], "Area": ["Site"], "Line": ["Area"], "Equipment": ["Line", "Equipment"], "Variable": ["Equipment"]},
    "profile_level_mappings": [{"source_term": "Production Line", "target_level": "Line", "mapping_kind": "profile_mapping", "review_required": true}],
    "fallback_policy": {"unresolved_parent": "Keep unassigned; do not guess."}
  },
  "entity_types": [
    {"code": "Reactor", "label": "Reactor", "definition": "Process vessel in which a transformation occurs.", "aliases": ["reactor", "vessel", "reactor vessel"], "regex": ["\\breactor\\b", "\\bvessel\\b"], "node_classes": ["Object"], "compatible_parent_codes": [], "source_references": ["IEC-62264-1"], "mapping_kind": "local_profile_concept", "status": "active"},
    {"code": "Pump", "label": "Pump", "definition": "Equipment that moves fluid by adding energy.", "aliases": ["pump", "pmp", "transfer pump"], "regex": ["\\bpump\\b", "\\bpmp\\b"], "node_classes": ["Object"], "compatible_parent_codes": [], "source_references": ["OPC-40223", "IEC-62264-1"], "mapping_kind": "local_profile_concept", "status": "active"},
    {"code": "Motor", "label": "Electric motor", "definition": "Equipment converting electrical energy into mechanical motion.", "aliases": ["motor", "drive motor"], "regex": ["\\b(motor|drive)\\b"], "node_classes": ["Object"], "compatible_parent_codes": ["Pump"], "source_references": ["IEC-62264-1"], "mapping_kind": "local_profile_concept", "status": "active"},
    {"code": "Valve", "label": "Valve", "definition": "Equipment regulating or directing fluid flow.", "aliases": ["valve", "control valve"], "regex": ["\\bvalve\\b"], "node_classes": ["Object"], "compatible_parent_codes": [], "source_references": ["IEC-62264-1"], "mapping_kind": "local_profile_concept", "status": "active"}
  ],
  "variable_semantics": [
    {"code": "OutletTemperature", "label": "Outlet temperature", "definition": "Temperature at an outlet location; require directional/context evidence.", "aliases": ["outlet temperature", "outlet temp", "t out"], "regex": ["(t[_ ]?out|outlet).*temp"], "quantity_kind": "thermodynamic temperature", "physical_dimension": "Theta", "data_types": ["Double", "Float", "i=11", "i=10"], "units": ["Cel", "K"], "compatible_entities": ["Reactor", "Pump"], "measurement_role": "measurement", "direction": "outlet", "sibling_hints": ["pressure", "flow"], "source_references": ["OPC-10000-5", "UCUM"], "mapping_kind": "profile_semantic", "status": "active"},
    {"code": "Temperature", "label": "Temperature", "definition": "Temperature where no more specific location or role is evidenced.", "aliases": ["temperature", "temp"], "regex": ["\\b(temp|temperature)\\b"], "quantity_kind": "thermodynamic temperature", "physical_dimension": "Theta", "data_types": ["Double", "Float", "i=11", "i=10"], "units": ["Cel", "K"], "compatible_entities": ["Reactor", "Pump"], "measurement_role": "measurement", "direction": "unspecified", "sibling_hints": [], "source_references": ["OPC-10000-5", "UCUM"], "mapping_kind": "profile_semantic", "status": "active"},
    {"code": "Pressure", "label": "Pressure", "definition": "Process pressure; reference type and location need source context.", "aliases": ["pressure", "p discharge", "p disch"], "regex": ["\\bpressure\\b", "p[_ ]?(disch|out)"], "quantity_kind": "pressure", "physical_dimension": "M L-1 T-2", "data_types": ["Double", "Float", "i=11", "i=10"], "units": ["Pa", "kPa", "bar"], "compatible_entities": ["Reactor", "Pump"], "measurement_role": "measurement", "direction": "requires context", "sibling_hints": ["temperature", "flow"], "source_references": ["OPC-10000-5", "UCUM"], "mapping_kind": "profile_semantic", "status": "active"},
    {"code": "MotorSpeed", "label": "Motor rotational speed", "definition": "Motor or shaft rotations per time; distinguish from angular velocity.", "aliases": ["motor speed", "speed", "rpm", "n motor"], "regex": ["\\b(speed|rpm)\\b", "n[_ ]?motor"], "quantity_kind": "rotational frequency", "physical_dimension": "T-1", "data_types": ["Double", "Float", "i=11", "i=10"], "units": ["min-1"], "compatible_entities": ["Pump", "Motor"], "measurement_role": "measurement", "direction": "not applicable", "sibling_hints": ["motor current", "power", "run status"], "source_references": ["OPC-10000-5", "UCUM"], "mapping_kind": "profile_semantic", "status": "active"},
    {"code": "FlowRate", "label": "Volumetric flow rate", "definition": "Volume per time; do not conflate with mass flow.", "aliases": ["flow rate", "volumetric flow", "flow"], "regex": ["\\b(flow|flowrate)\\b"], "quantity_kind": "volume flow rate", "physical_dimension": "L3 T-1", "data_types": ["Double", "Float", "i=11", "i=10"], "units": ["m3/s", "m3/h", "L/min"], "compatible_entities": ["Reactor", "Pump", "Valve"], "measurement_role": "measurement", "direction": "requires context", "sibling_hints": ["pressure", "temperature"], "source_references": ["OPC-10000-5", "UCUM"], "mapping_kind": "profile_semantic", "status": "active"},
    {"code": "RunStatus", "label": "Run status", "definition": "Explicit equipment operating state; do not infer from speed alone.", "aliases": ["run status", "running", "run state"], "regex": ["\\b(run.?status|run.?state|running)\\b"], "quantity_kind": "equipment state", "physical_dimension": "not applicable", "data_types": ["Boolean", "i=1"], "units": [], "compatible_entities": ["Pump", "Motor"], "measurement_role": "state", "direction": "not applicable", "sibling_hints": ["motor speed", "current"], "source_references": ["OPC-10000-5"], "mapping_kind": "profile_semantic", "status": "active"}
  ],
  "unit_dictionary": {
    "Cel": {"code_system": "UCUM", "quantity_kind": "thermodynamic temperature", "physical_dimension": "Theta", "aliases": ["degC", "°C", "Celsius"]},
    "K": {"code_system": "UCUM", "quantity_kind": "thermodynamic temperature", "physical_dimension": "Theta", "aliases": ["kelvin"]},
    "Pa": {"code_system": "UCUM", "quantity_kind": "pressure", "physical_dimension": "M L-1 T-2", "aliases": ["pascal"]},
    "kPa": {"code_system": "UCUM", "quantity_kind": "pressure", "physical_dimension": "M L-1 T-2", "aliases": ["kilopascal", "kilopascals"]},
