    {"standard_id": "OPC-10000-5", "edition": "OPC UA 1.05 family; verify exact revision", "uri": "https://reference.opcfoundation.org/specs/OPC-10000-5", "scope": "OPC UA Information Model", "applicability": "type and property context"},
    {"standard_id": "IEC-62264-1", "edition": "IEC 62264-1:2013, Edition 2; confirm current status", "uri": "https://www.iso.org/standard/57308.html", "scope": "Enterprise-control integration and equipment hierarchy terminology", "applicability": "target hierarchy design; profile mapping is local"},
    {"standard_id": "UCUM", "edition": "UCUM 2.2 (2024-06-17)", "uri": "https://ucum.org/ucum", "scope": "Machine-readable unit codes", "applicability": "listed unit identifiers only; no full parser or converter"},
